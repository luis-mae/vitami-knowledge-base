{
  "version": "1.1.0",
  "status": "implementation_contract",
  "entry_step": {
    "id": "select_goals",
    "prompt": {
      "es": "¿Qué te gustaría lograr o mejorar?",
      "en": "What would you like to achieve or improve?",
      "it": "Che cosa vorresti ottenere o migliorare?"
    },
    "source": "data/goals/goal_bank_master.json",
    "min_selection": 1,
    "max_selection": 5,
    "allow_change_later": true
  },
  "flow": [
    "select_goals",
    "compact_profile_screen",
    "shared_safety_questions",
    "goal_specific_questions",
    "rule_requested_followups",
    "basic_results",
    "optional_paid_pro_analysis"
  ],
  "selection_policy": {
    "deduplicate_questions": true,
    "ask_shared_question_once": true,
    "order_by": [
      "critical_safety",
      "shared_profile",
      "goal_relevance",
      "rule_followup"
    ],
    "do_not_infer_supplement_from_goal": true,
    "do_not_skip_required_safety_questions": true,
    "unanswered_critical_questions_block_actionable_recommendation": true
  },
  "goal_question_routes": [
    {
      "goals": [
        "sleep_rest"
      ],
      "questions": [
        "symptom_sleep",
        "sleep_hours",
        "sleep_problem_type",
        "lifestyle_caffeine_daily"
      ]
    },
    {
      "goals": [
        "strength_muscle",
        "sports_performance",
        "exercise_recovery"
      ],
      "questions": [
        "activity_level",
        "activity_type",
        "activity_intensity",
        "activity_session_duration",
        "activity_days_per_week",
        "diet_protein_sources"
      ]
    },
    {
      "goals": [
        "dietary_gaps"
      ],
      "questions": [
        "diet_type",
        "diet_fatty_fish_weekly",
        "diet_fruit_veg_daily",
        "diet_fortified_foods"
      ]
    },
    {
      "goals": [
        "digestive_health"
      ],
      "questions": [
        "symptom_digestive",
        "diet_fiber_sources",
        "hydration_status"
      ]
    },
    {
      "goals": [
        "energy_vitality"
      ],
      "questions": [
        "symptom_fatigue",
        "sleep_hours",
        "diet_type"
      ]
    }
  ],
  "routing_note": "Route question IDs must be validated against the current question bank before enabling; unrecognized IDs must be ignored and flagged, never displayed as fabricated questions.",
  "basic_pro": "Both tiers begin with goals; PRO can deepen goal-specific followups but BASIC safety information stays free.",
  "compact_profile_screen": {
    "layout": "single_responsive_screen",
    "title": {
      "es": "Contanos un poco sobre vos",
      "en": "Tell us a little about yourself",
      "it": "Raccontaci qualcosa di te"
    },
    "fields": [
      {
        "question_id": "profile_age",
        "required": true
      },
      {
        "question_id": "profile_sex_reference",
        "required": "only_when_reference_depends_on_it"
      },
      {
        "question_id": "pro_height",
        "required": false,
        "visibility": "when_needed_for_selected_goal_or_supported_calculation"
      },
      {
        "question_id": "pro_weight",
        "required": false,
        "visibility": "when_needed_for_selected_goal_or_supported_calculation"
      }
    ],
    "units": {
      "height": [
        "cm"
      ],
      "weight": [
        "kg"
      ]
    },
    "validation": "Use existing question-bank constraints; do not make height or weight universal mandatory inputs.",
    "interaction": "Show compact grouped inputs, preserve answers on back navigation and allow edits."
  },
  "question_ui": {
    "group_related_questions": true,
    "conditional_subquestions": true,
    "hide_irrelevant_questions": true,
    "ask_once_for_multiple_goals": true,
    "show_progress_by_section": true,
    "never_skip_critical_safety": true
  },
  "results_actions": {
    "paid_pro_analysis": {
      "optional": true,
      "after_basic": true,
      "do_not_paywall_basic_safety": true
    },
    "existing_cart": {
      "restore": true,
      "show_only_when_valid_product_mapping_and_commerce_enabled": true,
      "never_auto_add": true
    }
  }
}

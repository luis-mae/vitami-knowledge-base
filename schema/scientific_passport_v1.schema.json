{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VITAMI Scientific Passport v1",
  "description": "Read-only provenance and review contract; a passport never activates a rule or authorizes dosing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "passport_version",
    "rule_id",
    "evidence_claim_ids",
    "source_ids",
    "review",
    "safety",
    "presentation"
  ],
  "properties": {
    "passport_version": {
      "const": "1.0.0"
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_claim_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "last_reviewed_at",
        "reviewer",
        "source_passage_verified",
        "certainty_assessed"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "evidence_review",
            "professional_review",
            "approved",
            "deprecated"
          ]
        },
        "last_reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_passage_verified": {
          "type": "boolean"
        },
        "certainty_assessed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_ids",
        "professional_approval",
        "contraindications_reviewed",
        "interactions_reviewed"
      ],
      "properties": {
        "gate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "professional_approval": {
          "type": "boolean"
        },
        "contraindications_reviewed": {
          "type": "boolean"
        },
        "interactions_reviewed": {
          "type": "boolean"
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "claim_text",
        "source_attribution",
        "endorsement_disclaimer"
      ],
      "properties": {
        "locale": {
          "enum": [
            "es",
            "en",
            "it"
          ]
        },
        "claim_text": {
          "type": "string"
        },
        "source_attribution": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "organization",
              "title",
              "url"
            ],
            "properties": {
              "source_id": {
                "type": "string"
              },
              "organization": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "logo_permission": {
                "enum": [
                  "not_checked",
                  "denied",
                  "licensed"
                ]
              }
            }
          }
        },
        "endorsement_disclaimer": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "source_passage_verified": {
                "const": true
              },
              "certainty_assessed": {
                "const": true
              },
              "last_reviewed_at": {
                "type": "string"
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "safety": {
            "properties": {
              "professional_approval": {
                "const": true
              },
              "contraindications_reviewed": {
                "const": true
              },
              "interactions_reviewed": {
                "const": true
              }
            }
          },
          "presentation": {
            "properties": {
              "endorsement_disclaimer": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}

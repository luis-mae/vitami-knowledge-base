        "fish_servings_weekly",
        "fatty_fish_servings_weekly",
        "fruit_vegetable_frequency",
        "dairy_or_calcium_sources",
        "fortified_food_use",
        "animal_product_intake",
        "legume_nut_seed_frequency"
      ]
    },
    {
      "family_id": "lifestyle_exposure",
      "tier": "BASIC",
      "purpose": "Contextual factors relevant to selected nutrients",
      "candidate_variables": [
        "sun_exposure_pattern",
        "smoking",
        "alcohol_frequency",
        "caffeine_quantity",
        "activity_level"
      ]
    },
    {
      "family_id": "current_supplements",
      "tier": "BASIC",

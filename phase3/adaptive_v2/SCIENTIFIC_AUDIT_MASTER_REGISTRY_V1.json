  "mandatory_criteria": [
    "Claim-to-source traceability with document version, access date, population, indication and outcomes",
    "Independent evaluation of source quality, study bias and applicability",
    "Interaction checks for each product alone and in combination",
    "Fail closed on unknown safety answers and unverified cumulative doses",
    "Distinguish treatment, prevention, nutritional adequacy and performance",
    "No automatic clinical approval inferred from presence of source reference"
  ],
  "sampled_rule_review_count": 7,
  "critical_findings": [
    {
      "rule": "VITK_CURRENT_USE_MEDICATION",
      "severity": "high",
      "finding": "Requires vitamin K already being used, so proposed initiation while taking a vitamin K antagonist may escape this gate.",
      "fix": "Assess prospective addition and medication identity, particularly warfarin; no clearance based only on a generic medication boolean."
    },
    {
      "rule": "CAFF_HIGH_BASELINE",
      "severity": "high",
      "finding": "Condition value '>=300mg' is a string and requires an explicit validated numeric comparator; cannot assume a threshold is evaluated.",
      "fix": "Normalize mg/day caffeine from all sources, define numeric threshold and check pregnancy, arrhythmia, insomnia and medication context."
    },
    {
      "rule": "IRON_FATIGUE_ONLY",
      "severity": "medium",
      "finding": "Requesting availability of lab data is not confirmation of deficiency.",
      "fix": "No treatment recommendation without clinical context and verified deficiency workup."
    },
    {
      "rule": "BIOTIN_HAIR_ONLY",
      "severity": "medium",
      "finding": "Positive score for hair concern risks implying efficacy without deficiency.",
      "fix": "Do not award benefit score solely for cosmetic concern; evaluate lab assay interference."
    },
    {
      "rule": "CREATINE_KIDNEY",
      "severity": "review",
      "finding": "Known kidney disease triggers review but unknown kidney status must not be treated as negative.",
      "fix": "Explicit missing-data safety gate."
    },
    {
      "rule": "MELATONIN_CHRONIC_INSOMNIA",
      "severity": "review",
      "finding": "Rule correctly avoids routine melatonin recommendation for chronic insomnia.",
      "fix": "Verify guideline-supported behavioral treatment and red flags."
    },
    {
      "rule": "O3_BLEEDING",
      "severity": "review",
      "finding": "Bleeding/surgery gate exists; individualized context and formulation matter.",
      "fix": "Review anticoagulants, antiplatelets, high-dose omega-3, atrial fibrillation and product type."
    }
  ],

    "max_selected": 5,
    "minimum_selected": 1,
    "rank_method": "selection_order_with_reorder",
    "rank_weights": [
      5,
      4,
      3,
      2,
      1
    ],
    "weights_usage": "navigation_and_ordering_only_not_evidence_or_safety",
    "goals": [
